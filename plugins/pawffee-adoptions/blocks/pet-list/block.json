{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pawffee/pet-list",
	"version": "1.0.0",
	"title": "Adoptable pets",
	"category": "widgets",
	"icon": "pets",
	"description": "Lists the café's adoptable pets from their profiles. Add, edit or reorder pets under Pets in the dashboard.",
	"keywords": [ "adoption", "pets", "residents" ],
	"textdomain": "pawffee-adoptions",
	"attributes": {
		"species": {
			"type": "string",
			"enum": [ "all", "dog", "cat" ],
			"default": "all"
		},
		"showPending": {
			"type": "boolean",
			"default": true
		},
		"showAdopted": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"multiple": true,
		"reusable": false
	},
	"editorScript": "file:./editor.js",
	"render": "file:./render.php"
}
